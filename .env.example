# SQLite database URL used by Prisma
DATABASE_URL="file:./dev.db"

# MCP Streamable HTTP endpoint and optional bearer token.
# The MCP server must provide the chat, web_search, and page_reader tools.
MCP_SERVER_URL=""
MCP_AUTH_TOKEN=""
MCP_CHAT_TOOL="chat"
MCP_SEARCH_TOOL="web_search"
MCP_READ_PAGE_TOOL="page_reader"

# Do not commit API keys or other credentials.
